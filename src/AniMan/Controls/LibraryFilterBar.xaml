<UserControl x:Class="AniMan.Controls.LibraryFilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:AniMan.Localization"
             xmlns:vm="clr-namespace:AniMan.ViewModels.Library"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900">

    <!-- DataContext: the page's LibraryViewModelBase (inherited). -->
    <StackPanel>

        <!-- Active filters, shown while the panel is closed: one click removes each -->
        <WrapPanel Margin="24,10,24,0"
                   Visibility="{Binding ShowActiveFilterBar, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding ActiveFilters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ActiveFilterViewModel}">
                        <ui:Button Command="{Binding RemoveCommand}" Appearance="Secondary"
                                   Padding="10,3" Margin="0,0,6,6" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                <ui:SymbolIcon Symbol="Dismiss12" FontSize="11" Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ui:Button Content="{loc:Loc Library_ClearFilters}" Command="{Binding ClearFiltersCommand}"
                       Appearance="Transparent" Padding="10,3" Margin="0,0,0,6" FontSize="12"/>
        </WrapPanel>

        <!-- Filter panel -->
        <Border Margin="24,10,24,0" Padding="16,12"
                CornerRadius="{StaticResource CornerMd}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource HairlineBorderBrush}" BorderThickness="1"
                Visibility="{Binding IsFilterPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" MaxHeight="300" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Year range + my rating -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Library_FilterYear}" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox Grid.Column="1" MinWidth="100"
                                      ItemsSource="{Binding YearOptions}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding YearFrom}"/>
                            <TextBlock Grid.Column="2" Text="–" Margin="8,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="3" MinWidth="100"
                                      ItemsSource="{Binding YearOptions}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding YearTo}"/>
                            <TextBlock Grid.Column="5" Text="{loc:Loc Library_FilterMyRating}" VerticalAlignment="Center"
                                       FontSize="12" Margin="0,0,10,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox Grid.Column="6" MinWidth="110"
                                      ItemsSource="{Binding RatingOptions}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding RatingFilter}"/>
                        </Grid>

                        <!-- Chip groups; a group with no values in this library hides itself -->
                        <ItemsControl ItemsSource="{Binding FilterGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FilterGroupViewModel}">
                                    <Grid Margin="0,0,0,4"
                                          Visibility="{Binding HasChips, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Top" Margin="0,5,8,0">
                                            <TextBlock Text="{Binding Header}" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <!-- All / Any switch: only once 2+ values are picked (1 gives the same result either way).
                                                 No GroupName: the two radios group by their shared parent, so rows don't interfere. -->
                                            <Border Margin="0,6,0,0" HorizontalAlignment="Left"
                                                    CornerRadius="4" ClipToBounds="True"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                                    Visibility="{Binding ShowMatchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Style="{StaticResource SegmentRadioButton}"
                                                                 Padding="8,2" FontSize="11"
                                                                 Content="{loc:Loc Library_MatchAll}"
                                                                 ToolTip="{loc:Loc Library_MatchAllTip}"
                                                                 IsChecked="{Binding MatchAll, Mode=OneWay}"
                                                                 Command="{Binding SetMatchAllCommand}"/>
                                                    <RadioButton Style="{StaticResource SegmentRadioButton}"
                                                                 Padding="8,2" FontSize="11"
                                                                 Content="{loc:Loc Library_MatchAny}"
                                                                 ToolTip="{loc:Loc Library_MatchAnyTip}"
                                                                 IsChecked="{Binding MatchAny, Mode=OneWay}"
                                                                 Command="{Binding SetMatchAnyCommand}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Chips}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:FilterChipViewModel}">
                                                    <ToggleButton Style="{StaticResource FilterChip}"
                                                                  Content="{Binding Display}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <ui:Button Grid.Row="1" HorizontalAlignment="Right" Margin="0,8,0,0"
                           Content="{loc:Loc Library_ClearFilters}" Command="{Binding ClearFiltersCommand}"
                           Appearance="Transparent" FontSize="12"
                           Visibility="{Binding HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
