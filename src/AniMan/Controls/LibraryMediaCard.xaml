<UserControl x:Class="AniMan.Controls.LibraryMediaCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="262" d:DesignWidth="150"
             x:Name="Root"
             Focusable="True" IsTabStop="True" FocusVisualStyle="{x:Null}">

    <!--
      Three info levels, driven by Detail (library cover-size slider):
        Compact  — cover + thin progress line; title/status slide in on hover
        Standard — cover + status badge, title, progress text and bar
        Detailed — Standard with a two-line title and the MAL score
      The level-specific parts are templates in Themes/Styles.xaml ("LIBRARY CARD PARTS"),
      so a card builds only what its level shows.
    -->
    <Border Style="{StaticResource LibraryCardFrame}"
            Width="{Binding CardWidth, ElementName=Root}"
            AutomationProperties.Name="{Binding Title, ElementName=Root}">
        <StackPanel>
            <!-- Cover area -->
            <Border Style="{StaticResource LibraryCardCover}"
                    Height="{Binding CoverHeight, ElementName=Root}">
                <Grid>
                    <!-- Placeholder fill shown while cover is loading or missing -->
                    <Rectangle Fill="{DynamicResource ControlFillColorDefaultBrush}"/>

                    <Image Source="{Binding CoverSource, ElementName=Root}"
                           Stretch="UniformToFill"/>

                    <!-- Status badge (Standard / Detailed) -->
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                            Margin="8" Padding="7,3"
                            CornerRadius="{StaticResource CornerSm}"
                            Background="{Binding StatusBackground, ElementName=Root}"
                            Visibility="{Binding IsCompact, ElementName=Root,
                                Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding StatusName, ElementName=Root}"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="{Binding StatusForeground, ElementName=Root}"/>
                    </Border>

                    <!-- Compact only: rating badge, hover title, thin progress line -->
                    <ContentPresenter Style="{StaticResource LibraryCardCoverParts}"/>
                </Grid>
            </Border>

            <!-- Footer: progress, or ratings on the My Ratings tab; none when Compact -->
            <ContentPresenter Style="{StaticResource LibraryCardFooter}"/>
        </StackPanel>
    </Border>
</UserControl>
