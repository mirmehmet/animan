<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand Violet -->
    <SolidColorBrush x:Key="BrandAccentBrush"     Color="#8B5CF6"/>
    <SolidColorBrush x:Key="BrandAccentLightBrush" Color="#A78BFA"/>

    <!-- Violet → Pink gradient for hero / featured accents -->
    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#8B5CF6" Offset="0"/>
        <GradientStop Color="#EC4899" Offset="1"/>
    </LinearGradientBrush>

    <!-- Genre / status tags — translucent violet tints, legible on both themes -->
    <SolidColorBrush x:Key="GenreTagBackgroundBrush" Color="#1F8B5CF6"/>
    <SolidColorBrush x:Key="GenreTagBorderBrush"     Color="#4D8B5CF6"/>

    <!-- Overlays -->
    <SolidColorBrush x:Key="CardOverlayBrush"    Color="#CC000000"/>
    <SolidColorBrush x:Key="HairlineBorderBrush"  Color="#14FFFFFF"/>

</ResourceDictionary>
