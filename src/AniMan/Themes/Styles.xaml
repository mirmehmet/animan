<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:conv="clr-namespace:AniMan.Converters"
                    xmlns:ctrl="clr-namespace:AniMan.Controls"
                    xmlns:loc="clr-namespace:AniMan.Localization">

    <!-- ═══════════════════════════════════════════════════════════════════════
         GLOBAL TEXTBLOCK DEFAULT
         Ensures all TextBlocks respond to theme changes via DynamicResource
         instead of relying on inherited-property propagation (which can lag).
         Explicit Foreground on any TextBlock overrides this style.
    ═══════════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
    </Style>

    <Style TargetType="UserControl">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFontFamily}"/>
    </Style>

    <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
    </Style>

    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         TYPOGRAPHY
    ═══════════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.PageTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SectionSubheaderText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="2,18,0,8"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MEDIA CARD  –  hover: scale 1.03 + violet glow shadow
    ═══════════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="MediaCard" TargetType="Border">
        <Setter Property="CornerRadius"          Value="{StaticResource CornerMd}"/>
        <Setter Property="BorderBrush"           Value="{DynamicResource HairlineBorderBrush}"/>
        <Setter Property="BorderThickness"       Value="1"/>
        <Setter Property="Cursor"                Value="Hand"/>
        <!-- Release without a press on the card (e.g. title-bar double-click maximize) is not a click -->
        <Setter Property="ctrl:ClickGuard.IsEnabled" Value="True"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#8B5CF6" Opacity="0.20"
                                          ShadowDepth="0" BlurRadius="18"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                            To="1.03" Duration="{StaticResource Anim.Med}" DecelerationRatio="0.7"/>
                        <DoubleAnimation
                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                            To="1.03" Duration="{StaticResource Anim.Med}" DecelerationRatio="0.7"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                            To="1.0" Duration="{StaticResource Anim.Fast}"/>
                        <DoubleAnimation
                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                            To="1.0" Duration="{StaticResource Anim.Fast}"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         GENRE PILL  –  violet-tinted soft tag for genre labels
    ═══════════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="GenrePill" TargetType="Border">
        <Setter Property="CornerRadius"    Value="{StaticResource CornerTag}"/>
        <Setter Property="Background"      Value="{StaticResource GenreTagBackgroundBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource GenreTagBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="10,4"/>
        <Setter Property="Margin"          Value="0,0,6,6"/>
    </Style>

    <!-- Library filter value chip: outlined when off, accent-tinted when selected -->
    <Style x:Key="FilterChip" TargetType="ToggleButton">
        <Setter Property="FontFamily"       Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="Foreground"       Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Padding"          Value="10,4"/>
        <Setter Property="Margin"           Value="0,0,6,6"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource CornerTag}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background"  Value="{StaticResource GenreTagBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BrandAccentBrush}"/>
                            <Setter Property="Foreground"  Value="{StaticResource BrandAccentBrush}"/>
                            <Setter Property="FontWeight"  Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Themes (Military, School, …): genre pill shape without the tinted fill -->
    <Style x:Key="ThemePill" TargetType="Border" BasedOn="{StaticResource GenrePill}">
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         PROGRESS BAR  –  brand accent foreground + rounded track
    ═══════════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="BrandProgressBar" TargetType="ProgressBar"
           BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Foreground"      Value="{StaticResource BrandGradientBrush}"/>
        <Setter Property="Background"      Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height"          Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="PART_Track"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            ClipToBounds="True">
                        <Border x:Name="PART_Indicator"
                                CornerRadius="4"
                                Background="{TemplateBinding Foreground}"
                                HorizontalAlignment="Left"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         PILL TAB  –  replaces TabRadioButton; accent underline → solid pill
    ═══════════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="PillTab" TargetType="RadioButton">
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="BorderBrush"     Value="Transparent"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextFillColorTertiaryBrush}"/>
        <Setter Property="Padding"         Value="14,9"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="FontWeight"      Value="Medium"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BrandAccentBrush}"/>
                            <Setter Property="Foreground"  Value="{StaticResource BrandAccentBrush}"/>
                            <Setter Property="FontWeight"  Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SEGMENT RADIO BUTTON  –  Theme Light / Dark / System picker
    ═══════════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="SegmentRadioButton" TargetType="RadioButton">
        <Setter Property="FontFamily"       Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="Foreground"       Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Padding"          Value="16,6"/>
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Seg"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Seg" Property="Background"   Value="{StaticResource BrandAccentBrush}"/>
                            <Setter TargetName="Seg" Property="BorderBrush"  Value="{StaticResource BrandAccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Seg" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SETTINGS CARD  –  consistent margin on ui:CardControl
    ═══════════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="SettingCard" TargetType="ui:CardControl"
           BasedOn="{StaticResource {x:Type ui:CardControl}}">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         STATUS PILL RADIO  –  for Detail page status selection (active = checked)
    ═══════════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="StatusPillRadio" TargetType="RadioButton">
        <Setter Property="FontFamily"       Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="Foreground"       Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="Padding"          Value="10,4"/>
        <Setter Property="Margin"           Value="0,0,6,0"/>
        <Setter Property="FontSize"         Value="11"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerTag}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- IsChecked comes AFTER IsMouseOver so hovering the selected
                             pill keeps the solid accent fill instead of dimming it. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="{StaticResource GenreTagBackgroundBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="{StaticResource BrandAccentBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandAccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         BACK PILL BUTTON  –  modern capsule back button on DetailPage
    ═══════════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="BackPillButton" TargetType="Button">
        <Setter Property="FontFamily"       Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="Foreground"       Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Background"       Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Padding"          Value="14,7"/>
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="FontWeight"       Value="SemiBold"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PillBd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="18"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PillBd" Property="Background"  Value="{StaticResource GenreTagBackgroundBrush}"/>
                            <Setter TargetName="PillBd" Property="BorderBrush" Value="{StaticResource BrandAccentBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrandAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PillBd" Property="Background"  Value="{StaticResource BrandAccentBrush}"/>
                            <Setter TargetName="PillBd" Property="BorderBrush" Value="{StaticResource BrandAccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         LEFT FLUENT NAVIGATION ITEM  –  keeps label visible when selected
    ═══════════════════════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="LeftFluentNavigationViewItemTemplate"
                     TargetType="{x:Type ui:NavigationViewItem}">
        <Border x:Name="MainBorder"
                Width="60"
                Height="60"
                Padding="4"
                Margin="0,2"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1"
                CornerRadius="6"
                Cursor="Hand">
            <Grid>
                <Rectangle x:Name="ActiveRectangle"
                           Width="3"
                           Height="24"
                           Margin="-4,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Fill="{DynamicResource NavigationViewSelectionIndicatorForeground}"
                           Opacity="0.0"
                           RadiusX="2"
                           RadiusY="2"/>

                <Grid HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ContentPresenter x:Name="IconContentPresenter"
                                      Grid.Row="0"
                                      Margin="0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Content="{TemplateBinding Icon}"
                                      TextElement.FontSize="24"
                                      TextElement.Foreground="{DynamicResource NavigationViewItemForegroundLeftFluent}"/>

                    <Grid x:Name="ContentGrid"
                          Grid.Row="1"
                          Margin="0,2,0,0">
                        <ContentPresenter x:Name="ElementContentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          RecognizesAccessKey="True"
                                          TextElement.FontFamily="{DynamicResource AppFontFamily}"
                                          TextElement.FontSize="11"
                                          TextElement.Foreground="{DynamicResource NavigationViewItemForegroundLeftFluent}"/>
                    </Grid>

                    <ContentPresenter x:Name="PART_InfoBadge"
                                      Grid.Row="0"
                                      Margin="0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Content="{TemplateBinding InfoBadge}"/>
                </Grid>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsActive" Value="True">
                <Setter TargetName="ActiveRectangle" Property="Opacity" Value="1.0"/>
                <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundSelectedLeftFluent}"/>
                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
                <Setter TargetName="IconContentPresenter" Property="TextElement.Foreground" Value="{DynamicResource NavigationViewSelectionIndicatorForeground}"/>
                <Setter TargetName="ElementContentPresenter" Property="TextElement.Foreground" Value="{DynamicResource NavigationViewSelectionIndicatorForeground}"/>
                <Setter TargetName="ElementContentPresenter" Property="TextElement.FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconContentPresenter" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="InfoBadge" Value="{x:Null}">
                <Setter TargetName="PART_InfoBadge" Property="Margin" Value="0"/>
                <Setter TargetName="PART_InfoBadge" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundSelectedLeftFluent}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsActive" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="IconContentPresenter" Property="TextElement.Foreground" Value="{DynamicResource NavigationViewItemForegroundPointerOverLeftFluent}"/>
                <Setter TargetName="ElementContentPresenter" Property="TextElement.Foreground" Value="{DynamicResource NavigationViewItemForegroundPointerOverLeftFluent}"/>
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ═══════════════════════════════════════════════════════════════════════
         LIBRARY CARD PARTS  –  used by LibraryMediaCard
         Each card builds only the parts its current layout shows: a library page
         creates every card at once, and the hidden Compact/Ratings parts made up
         about a third of the cost (measured 27 Nov 2026). Inside the templates the
         DataContext is the card itself.
    ═══════════════════════════════════════════════════════════════════════════ -->

    <BooleanToVisibilityConverter x:Key="CardBoolToVisibility"/>

    <!-- Card frame: MediaCard plus a visible keyboard focus (Tab; Enter/Space opens it) -->
    <Style x:Key="LibraryCardFrame" TargetType="Border" BasedOn="{StaticResource MediaCard}">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=ctrl:LibraryMediaCard}}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrandAccentBrush}"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#8B5CF6" Opacity="0.20"
                                          ShadowDepth="0" BlurRadius="18"/>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Cover area: rounded top; all four corners when Compact (no footer below) -->
    <Style x:Key="LibraryCardCover" TargetType="Border">
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerCardTop}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=ctrl:LibraryMediaCard}}" Value="True">
                <Setter Property="CornerRadius" Value="{StaticResource CornerMd}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Compact: rating on the Ratings tab, title + status on hover, thin progress line -->
    <DataTemplate x:Key="LibraryCardCompactCover">
        <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType=ctrl:LibraryMediaCard}}">
            <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                    Margin="6" Padding="6,2"
                    CornerRadius="{StaticResource CornerTag}"
                    Background="{StaticResource CardOverlayBrush}"
                    ToolTip="{loc:Loc Detail_MyRating}"
                    Visibility="{Binding ShowRatings, Converter={StaticResource CardBoolToVisibility}}">
                <TextBlock Text="{Binding UserRatingText}"
                           FontSize="10" FontWeight="SemiBold" Foreground="White"/>
            </Border>

            <Border VerticalAlignment="Bottom" Padding="8,6,8,9"
                    Background="{StaticResource CardOverlayBrush}"
                    Visibility="{Binding IsMouseOver, Converter={StaticResource CardBoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               FontSize="11" FontWeight="SemiBold" Foreground="White"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30"/>
                    <TextBlock Text="{Binding StatusName}"
                               FontSize="9" Margin="0,2,0,0" Foreground="White" Opacity="0.8"/>
                </StackPanel>
            </Border>

            <ProgressBar Style="{StaticResource BrandProgressBar}"
                         VerticalAlignment="Bottom" Height="3"
                         Minimum="0" Maximum="100"
                         Value="{Binding ProgressPercent, Mode=OneWay}"
                         Foreground="{Binding ProgressAccent}"/>
        </Grid>
    </DataTemplate>

    <!-- Footer title: one line; Detailed cards have room for a two-line title. A fixed
         two-line height keeps every card in a row the same height. -->
    <Style x:Key="LibraryCardTitle" TargetType="TextBlock">
        <Setter Property="Text" Value="{Binding Title}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDetailed}" Value="True">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Height" Value="32"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Standard / Detailed footer: title, progress, and the MAL score when Detailed -->
    <DataTemplate x:Key="LibraryCardProgressFooter">
        <StackPanel Margin="10,6,10,8"
                    DataContext="{Binding RelativeSource={RelativeSource AncestorType=ctrl:LibraryMediaCard}}">
            <TextBlock Style="{StaticResource LibraryCardTitle}"/>
            <Grid Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ProgressText}" FontSize="10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" ToolTip="{loc:Loc Detail_MalScore}"
                            Visibility="{Binding IsDetailed, Converter={StaticResource CardBoolToVisibility}}">
                    <TextBlock Text="★" FontSize="10" Foreground="{StaticResource BrandAccentLightBrush}"/>
                    <TextBlock Text="{Binding MalScoreText}" FontSize="10" Margin="3,0,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
            <ProgressBar Style="{StaticResource BrandProgressBar}"
                         Minimum="0" Maximum="100"
                         Value="{Binding ProgressPercent, Mode=OneWay}"
                         Height="6"
                         Foreground="{Binding ProgressAccent}"/>
        </StackPanel>
    </DataTemplate>

    <!-- My Ratings tab footer: title, MAL score | user rating -->
    <DataTemplate x:Key="LibraryCardRatingsFooter">
        <StackPanel Margin="10,6,10,8"
                    DataContext="{Binding RelativeSource={RelativeSource AncestorType=ctrl:LibraryMediaCard}}">
            <TextBlock Style="{StaticResource LibraryCardTitle}"/>
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center"
                            ToolTip="{loc:Loc Detail_MalScore}">
                    <TextBlock Text="★" FontSize="11"
                               Foreground="{StaticResource BrandAccentLightBrush}"/>
                    <TextBlock Text="{Binding MalScoreText}"
                               FontSize="11" Margin="4,0,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Border Grid.Column="1" Padding="7,2"
                        CornerRadius="{StaticResource CornerTag}"
                        Background="{StaticResource GenreTagBackgroundBrush}"
                        ToolTip="{loc:Loc Detail_MyRating}">
                    <TextBlock Text="{Binding UserRatingText}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource BrandAccentBrush}"/>
                </Border>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!-- Picks the cover overlay: only Compact cards have one -->
    <Style x:Key="LibraryCardCoverParts" TargetType="ContentPresenter">
        <Setter Property="ContentTemplate" Value="{x:Null}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=ctrl:LibraryMediaCard}}" Value="True">
                <Setter Property="ContentTemplate" Value="{StaticResource LibraryCardCompactCover}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Picks the footer: progress, ratings (My Ratings tab), or none (Compact) -->
    <Style x:Key="LibraryCardFooter" TargetType="ContentPresenter">
        <Setter Property="ContentTemplate" Value="{StaticResource LibraryCardProgressFooter}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ShowRatings, RelativeSource={RelativeSource AncestorType=ctrl:LibraryMediaCard}}" Value="True">
                <Setter Property="ContentTemplate" Value="{StaticResource LibraryCardRatingsFooter}"/>
            </DataTrigger>
            <!-- Last, so it wins over Ratings -->
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=ctrl:LibraryMediaCard}}" Value="True">
                <Setter Property="ContentTemplate" Value="{x:Null}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
