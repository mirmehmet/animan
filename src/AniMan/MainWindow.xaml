<ui:FluentWindow x:Class="AniMan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:AniMan.Localization"
        xmlns:ctrl="clr-namespace:AniMan.Controls"
        mc:Ignorable="d"
        Title="AniMan"
        Icon="Assets/animan.ico"
        MinHeight="600" MinWidth="900"
        Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="None"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        FontFamily="{DynamicResource AppFontFamily}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="RootTitleBar"
                     Grid.Row="0"
                     Title="AniMan"/>

        <!-- AppNavigationView: WPF-UI NavigationView that releases visited transient pages (DetailPage) -->
        <ctrl:AppNavigationView x:Name="RootNavigation"
                           Style="{StaticResource {x:Type ui:NavigationView}}"
                           Grid.Row="1"
                           PaneDisplayMode="LeftFluent"
                           ItemTemplate="{StaticResource LeftFluentNavigationViewItemTemplate}"
                           FontFamily="{DynamicResource AppFontFamily}"
                           IsBackButtonVisible="Collapsed"
                           IsPaneOpen="False">

            <ctrl:AppNavigationView.MenuItems>
                <ui:NavigationViewItem Content="{loc:Loc Nav_Dashboard}"
                                       TargetPageType="{x:Type dashViews:DashboardPage}"
                                       xmlns:dashViews="clr-namespace:AniMan.Views.Dashboard">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{loc:Loc Nav_Anime}"
                                       TargetPageType="{x:Type views:AnimeLibraryPage}"
                                       xmlns:views="clr-namespace:AniMan.Views.Library">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Tv24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{loc:Loc Nav_Manga}"
                                       TargetPageType="{x:Type views:MangaLibraryPage}"
                                       xmlns:views="clr-namespace:AniMan.Views.Library">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="BookOpen24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{loc:Loc Nav_Discover}"
                                       TargetPageType="{x:Type views:DiscoverPage}"
                                       Click="OnDiscoverNavClicked"
                                       xmlns:views="clr-namespace:AniMan.Views.Discover">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Add24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{loc:Loc Nav_Stats}"
                                       TargetPageType="{x:Type views:StatsPage}"
                                       xmlns:views="clr-namespace:AniMan.Views.Stats">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DataHistogram24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ctrl:AppNavigationView.MenuItems>

            <ctrl:AppNavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{loc:Loc Nav_Settings}"
                                       TargetPageType="{x:Type views:SettingsPage}"
                                       xmlns:views="clr-namespace:AniMan.Views.Settings">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ctrl:AppNavigationView.FooterMenuItems>

        </ctrl:AppNavigationView>

        <!-- Window-wide progress overlay (backup import). Covers the content but not the title
             bar; blocks clicks via its background. DataContext is BusyOverlayViewModel (set in code). -->
        <Border x:Name="BusyOverlay"
                Grid.Row="1"
                Background="#99000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="440" Padding="24,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="{StaticResource CornerMd}"
                    Background="{DynamicResource ContentDialogBackground}"
                    BorderBrush="{DynamicResource HairlineBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                               Margin="0,0,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Message}" FontSize="13"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding PercentText}"
                                   FontSize="13" FontWeight="SemiBold" Margin="12,0,0,0"/>
                    </Grid>
                    <ProgressBar Value="{Binding Percent}" Maximum="100" Height="6" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Short, non-blocking failure notices for single actions (add, restore, empty trash) -->
        <ui:SnackbarPresenter x:Name="RootSnackbarPresenter"
                              Grid.Row="1"
                              VerticalAlignment="Bottom"/>

        <ui:ContentDialogHost x:Name="RootContentDialogHost"
                              Grid.Row="0" Grid.RowSpan="2"/>
    </Grid>
</ui:FluentWindow>
